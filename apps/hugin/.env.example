## Convex (required)
## Written automatically by `pnpm setup:local`.
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

## Local development auth (no Clerk account needed)
## `pnpm setup:local` sets these. Leave them out to use Clerk instead.
NEXT_PUBLIC_AUTH_PROVIDER=mock
DEV_AUTH_PRIVATE_JWK={"kty":"RSA",...}

## Clerk (required only when NEXT_PUBLIC_AUTH_PROVIDER is not "mock")
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test...
CLERK_SECRET_KEY=sk_test...

## Optional. Analytics and error reporting stay off when these are unset.
NEXT_PUBLIC_POSTHOG_KEY=phc_....
NEXT_PUBLIC_POSTHOG_HOST=https://....
NEXT_PUBLIC_SENTRY_DSN=https://....
SENTRY_DSN=https://....
