## Convex generated environment variables
CONVEX_DEPLOYMENT=dev:...
CONVEX_URL=http(s)://...

## Local development auth (no Clerk account needed)
## `pnpm setup:local` sets these on the deployment it creates.
DEV_AUTH_JWKS=data:text/plain;charset=utf-8;base64,...
LOCAL_DEVELOPMENT=true

## Clerk (required only when DEV_AUTH_JWKS is unset)
CLERK_WEBHOOK_SECRET=whsec_...
CLERK_FRONTEND_API_URL=https://...

## Resend. Emails are logged instead of sent when LOCAL_DEVELOPMENT is true.
RESEND_API_KEY=re_...
RESEND_TEST_MODE=false
