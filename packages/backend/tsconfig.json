{
	"compilerOptions": {
		"strict": true,
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "dom"],
		"jsx": "react-jsx",
		"types": ["vite/client"],
		"skipLibCheck": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,
		"noEmit": true
	},
	"include": ["test/**/*", "convex/**/*.test.ts", "vitest.config.ts"]
}
