{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"globalDependencies": [".env"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$"],
			"env": [
				"NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
				"CLERK_SECRET_KEY",
				"NEXT_PUBLIC_CONVEX_URL",
				"NEXT_PUBLIC_CONVEX_HOSTNAME",
				"RESEND_API_KEY",
				"SENTRY_AUTH_TOKEN",
				"CONVEX_DEPLOY_KEY"
			],
			"outputs": [".next/**", "!.next/cache/**"]
		},
		"compile": {
			"dependsOn": ["^compile"],
			"inputs": ["$TURBO_DEFAULT$"],
			"env": ["NEXT_PUBLIC_CONVEX_URL"],
			"outputs": []
		},
		"check-types": {
			"dependsOn": ["^check-types"],
			"inputs": ["$TURBO_DEFAULT$"],
			"env": ["NEXT_PUBLIC_CONVEX_URL"],
			"outputs": []
		},
		"test": {
			"dependsOn": ["^test"],
			"inputs": ["$TURBO_DEFAULT$"],
			"outputs": []
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"inputs": ["$TURBO_DEFAULT$", ".env", ".env.local"],
			"env": ["APP_ENV", "CONVEX_AGENT_MODE", "CONVEX_DEPLOYMENT", "NEXT_PUBLIC_CONVEX_URL"]
		}
	}
}
